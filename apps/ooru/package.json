  "scripts": {
    "dev": "concurrently \"tsx --watch src/server/index.ts\" \"vite\"",
    "build": "vite build && esbuild src/server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.69.0",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.1",
    "express": "^5.1.0",
    "idb-keyval": "^6.2.2",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "wouter": "^3.3.5",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.11",
    "@types/pg": "^8.11.10",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.3",
    "tsx": "^4.20.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.20"
  }
}
